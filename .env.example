# Anthropic
ANTHROPIC_API_KEY=

# FRED (Federal Reserve Economic Data) — https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# BLS (Bureau of Labor Statistics) — optional, public endpoint works without a key
BLS_API_KEY=

# Ghost DB — defaults to the docker-compose postgres service; leave as-is if using docker-compose
GHOST_DB_URL=postgresql://ghost:ghost@localhost:5432/ghostdb

# Overmind — optional, tracing skipped if unset
OVERMIND_API_KEY=

# Aerospike — defaults match docker-compose service
AEROSPIKE_HOST=localhost
AEROSPIKE_PORT=3000
AEROSPIKE_NAMESPACE=test
